# --- App ---
SECRET_KEY=change-me-to-a-long-random-string
DATABASE_URL=sqlite:///./ledgerly.db
# Use Postgres in production, e.g.:
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/ledgerly
FRONTEND_URL=http://localhost:5173

# --- Stripe (use sandbox / test keys: sk_test_...) ---
STRIPE_SECRET_KEY=sk_test_xxx
# From `stripe listen --forward-to localhost:8000/api/webhooks/stripe`
STRIPE_WEBHOOK_SECRET=whsec_xxx
DEFAULT_CURRENCY=usd

# --- Anthropic ---
ANTHROPIC_API_KEY=sk-ant-xxx
CLAUDE_FAST_MODEL=claude-haiku-5-5
CLAUDE_SMART_MODEL=claude-sonnet-5-5
